# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Public browser key for Google Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=

# ADMIN_PASSCODE: Optional server-side admin password override.
# If left empty, an inline first-run setup form allows claiming the initial admin password.
ADMIN_PASSCODE=

# ORDER_NOTIFICATION_EMAIL: Destination email receiving new customer orders.
ORDER_NOTIFICATION_EMAIL="domaineessaoudi@gmail.com"

# Optional Supabase Connection (can also be configured in Admin -> SQL Editor & Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# EmailJS Configuration (browser SDK public IDs from https://dashboard.emailjs.com)
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""

# Optional server-side EmailJS REST API keys
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""

# Optional SMTP fallback (used if EmailJS is not configured)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
